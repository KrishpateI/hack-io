# Public identifiers only. Never put secrets in VITE_* variables: they ship in the browser bundle.
VITE_API_BASE_URL=http://localhost:8000
# Realtime transport: appsync | websocket | sse
VITE_REALTIME_MODE=sse

# Basemap: self-hosted PMTiles extract (raster | vector). If absent, dev builds fall back to light-use OSM tiles; production never does.
VITE_PMTILES_URL=
VITE_PMTILES_KIND=raster

# Register the service worker in dev too (always on in production builds)
VITE_ENABLE_SW=false
