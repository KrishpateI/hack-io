# Raw source data (Req 45 / 42): never committed
data/raw/*
!data/raw/.gitkeep

# Intermediate download-stage outputs (regenerate with scripts/download_chicago_data.py)
data/processed/cdp_centerlines/
data/processed/osm_*/
# Normalized street segments (regenerate with scripts/process_streets.py)
data/processed/streets/

# Large generated artifacts (files > 50 MB are also rejected by scripts/check_large_files.py)
*.parquet
*.pbf
*.gpkg
*.shp
*.zip
*.tar.gz

# Node
node_modules/
frontend/dist/
frontend/.vite/

# Python / virtualenvs
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials*.json
.aws/

# Local runtime state
*.sqlite
*.sqlite3
.dynamodb/
.DS_Store

# pmtiles CLI binaries downloaded by scripts/extract_pmtiles.py
tools/bin/
# Secret scanning / CDK (task 14.10)
cdk.out/
credentials
*.p12
*.pfx
# Local copy of data/processed/tiles/chicago.pmtiles served by the Vite dev server (see README)
frontend/public/tiles/*.pmtiles
